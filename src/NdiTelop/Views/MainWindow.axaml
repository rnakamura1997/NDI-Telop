<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NdiTelop.ViewModels"
        xmlns:ctrl="using:NdiTelop.Controls"
        xmlns:i="using:Avalonia.Xaml.Interactivity"
        xmlns:core="using:Avalonia.Xaml.Interactions.Core"
        xmlns:conv="using:NdiTelop.Converters"
        xmlns:ac="using:Avalonia.Controls"
        x:Class="NdiTelop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="720"
        Title="NdiTelop"
        KeyDown="OnWindowKeyDown">
  <Design.DataContext>
    <vm:MainWindowViewModel />
  </Design.DataContext>

  <Window.Resources>
    <conv:StringToColorConverter x:Key="StringToColorConverter" />
  </Window.Resources>
  <Grid ColumnDefinitions="250,*,360" RowDefinitions="*,Auto">
    <!-- Left Column: Preset List and Controls -->
    <StackPanel Grid.Column="0" Margin="10" Spacing="5">
      <Button Content="Load Presets" Command="{Binding LoadPresetsCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Save Selected" Command="{Binding SaveSelectedPresetCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Duplicate Selected" Command="{Binding DuplicateSelectedPresetCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Delete Selected" Command="{Binding DeleteSelectedPresetCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Import Presets" Click="ImportPresetsButton_OnClick" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
      <Button Content="Export Selected" Click="ExportSelectedPresetButton_OnClick" HorizontalAlignment="Stretch" />
      <Button Content="Export All" Click="ExportAllPresetsButton_OnClick" HorizontalAlignment="Stretch" />
      <Button Content="Set Preview" Command="{Binding SelectPreviewPresetCommand}" CommandParameter="{Binding SelectedPreset}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
      <Button Content="TAKE" Command="{Binding TakeCommand}" HorizontalAlignment="Stretch" />
      <Button Content="CUT" Command="{Binding CutCommand}" HorizontalAlignment="Stretch" />
      <Button Content="Show Preset" Command="{Binding ShowPresetCommand}" CommandParameter="{Binding SelectedPreset}" HorizontalAlignment="Stretch" />
      <Button Content="⚙ 設定" Click="OpenSettingsButton_OnClick" HorizontalAlignment="Stretch" Margin="0,6,0,0" />
      <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <TextBox Grid.Column="0"
                 Text="{Binding PresetSearchKeyword, Mode=TwoWay}"
                 Watermark="Search presets" />
        <Button Grid.Column="1"
                Content="Clear"
                Command="{Binding ClearPresetSearchCommand}"
                Margin="6,0,0,0" />
      </Grid>
      <ListBox x:Name="PresetListBox"
               ItemsSource="{Binding FilteredPresets}"
               SelectedItem="{Binding SelectedPreset}"
               HorizontalAlignment="Stretch"
               VerticalAlignment="Stretch"
               Margin="0,6,0,0">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </StackPanel>

    <!-- Center Column: Preview Area -->
    <Border Grid.Column="1" Margin="10" BorderBrush="#333" BorderThickness="1" Background="Black">
      <ctrl:PreviewCanvas x:Name="PreviewCanvas" Preset="{Binding CurrentPreviewPreset}"
                          SelectedTextBlock="{Binding SelectedTextBlock, Mode=TwoWay}"
                          NdiConfig="{Binding NdiConfig}" />
    </Border>

    <!-- Right Column: Preset Editor and Overlay Manager -->
    <ScrollViewer Grid.Column="2" Margin="10" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="6">
      <TextBlock Text="Preset Editor" FontWeight="Bold" Margin="0,0,0,5" />
      <TextBlock Text="Name:" />
      <TextBox Text="{Binding SelectedPreset.Name}" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <TextBlock Text="Text Blocks" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="Add Block" Command="{Binding AddTextBlockCommand}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding SelectedPreset.TextBlocks}"
               SelectedItem="{Binding SelectedTextBlock, Mode=TwoWay}"
               MinHeight="140"
               MaxHeight="220">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <TextBox Text="{Binding Name, Mode=TwoWay}" Watermark="Block name" />
                <TextBlock Text="{Binding TextLines.Count, StringFormat={}Lines: {0}}" FontSize="11" Foreground="#AAAAAA" />
                <Button Content="Remove Block"
                        HorizontalAlignment="Right"
                        Command="{Binding DataContext.RemoveTextBlockCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <Border BorderBrush="#555" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,4,0,0">
      <StackPanel Spacing="6">
      <TextBlock Text="Selected Block" FontWeight="SemiBold" />
      <TextBlock Text="Block Name" />
      <TextBox Text="{Binding SelectedTextBlock.Name, Mode=TwoWay}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Text Lines" FontWeight="SemiBold" VerticalAlignment="Center" />
        <Button Content="Add Line" Command="{Binding AddTextLineCommand}" />
      </StackPanel>
      <ListBox ItemsSource="{Binding SelectedTextBlock.TextLines}" MinHeight="180">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Line Text" Width="70" VerticalAlignment="Center" />
                  <TextBox Text="{Binding Text, Mode=TwoWay}" HorizontalAlignment="Stretch" />
                </StackPanel>
                <Button Content="Remove" HorizontalAlignment="Right"
                        Command="{Binding DataContext.RemoveTextLineCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <TextBlock Text="Text Style" FontWeight="SemiBold" Margin="0,4,0,0" />
      <StackPanel Spacing="6">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Font" Width="90" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding AvailableFontFamilies}"
                    SelectedItem="{Binding SelectedTextBlock.TextStyle.FontFamily, Mode=TwoWay}"
                    HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Size" Width="90" VerticalAlignment="Center" />
          <TextBox Text="{Binding SelectedTextBlock.TextStyle.FontSize, Mode=TwoWay}" Width="90" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Color" Width="90" VerticalAlignment="Center" />
          <ac:ColorPicker Color="{Binding SelectedTextBlock.TextStyle.Color, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBlock Text="Outline" Width="90" VerticalAlignment="Center" />
          <TextBox Text="{Binding SelectedTextBlock.TextStyle.OutlineThickness, Mode=TwoWay}" Width="90" Watermark="Width" />
          <ac:ColorPicker Color="{Binding SelectedTextBlock.TextStyle.OutlineColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <TextBlock Text="Shadow" FontWeight="SemiBold" />
        <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
          <TextBlock Grid.Row="0" Grid.Column="0" Text="Offset X" VerticalAlignment="Center" />
          <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTextBlock.TextStyle.ShadowOffsetX, Mode=TwoWay}" />
          <TextBlock Grid.Row="1" Grid.Column="0" Text="Offset Y" VerticalAlignment="Center" />
          <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTextBlock.TextStyle.ShadowOffsetY, Mode=TwoWay}" />
          <TextBlock Grid.Row="2" Grid.Column="0" Text="Blur" VerticalAlignment="Center" />
          <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTextBlock.TextStyle.ShadowBlur, Mode=TwoWay}" />
          <TextBlock Grid.Row="3" Grid.Column="0" Text="Color" VerticalAlignment="Center" />
          <ac:ColorPicker Grid.Row="3" Grid.Column="1" Color="{Binding SelectedTextBlock.TextStyle.ShadowColor, Mode=TwoWay, Converter={StaticResource StringToColorConverter}}" HorizontalAlignment="Stretch" />
        </Grid>
      </StackPanel>

      <TextBlock Text="Text Layout" FontWeight="SemiBold" Margin="0,4,0,0" />
      <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Horizontal" VerticalAlignment="Center" />
        <ComboBox Grid.Row="0" Grid.Column="1"
                  ItemsSource="{Binding AvailableHorizontalAlignments}"
                  SelectedItem="{Binding SelectedTextBlock.TextLayout.HorizontalAlignment, Mode=TwoWay}" />
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Vertical" VerticalAlignment="Center" />
        <ComboBox Grid.Row="1" Grid.Column="1"
                  ItemsSource="{Binding AvailableVerticalAlignments}"
                  SelectedItem="{Binding SelectedTextBlock.TextLayout.VerticalAlignment, Mode=TwoWay}" />
        <TextBlock Grid.Row="2" Grid.Column="0" Text="Offset X" VerticalAlignment="Center" />
        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTextBlock.TextLayout.OffsetX, Mode=TwoWay}" Watermark="Pixels" />
        <TextBlock Grid.Row="3" Grid.Column="0" Text="Offset Y" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTextBlock.TextLayout.OffsetY, Mode=TwoWay}" Watermark="Pixels" />
      </Grid>
      </StackPanel>
      </Border>

      <TextBlock Text="Transition Type:" />
      <ComboBox ItemsSource="{Binding AvailableTransitionTypes}"
                SelectedItem="{Binding SelectedPreset.Animation.InType, Mode=TwoWay}" />
      <TextBlock Text="Auto Clear (seconds):" />
      <TextBox Text="{Binding SelectedPreset.AutoClearSeconds}" />

      <TextBlock Text="Overlay Manager" FontWeight="Bold" Margin="0,10,0,5" />
      <Button Content="画像をインポート" Click="ImportImageButton_OnClick" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
      <ListBox ItemsSource="{Binding SelectedPreset.Overlays}" MinHeight="260">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="#444" BorderThickness="1" CornerRadius="4" Padding="6" Margin="0,0,0,6">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Path}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <CheckBox Content="表示" IsChecked="{Binding IsVisible, Mode=TwoWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <TextBlock Text="Opacity" VerticalAlignment="Center" />
                  <Slider Minimum="0" Maximum="1" Value="{Binding Opacity, Mode=TwoWay}" TickFrequency="0.05" IsSnapToTickEnabled="False" Width="130" />
                  <TextBlock Text="{Binding Opacity, StringFormat={}{0:F2}}" Width="40" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>


      <TextBlock Text="Asset Browser" FontWeight="Bold" Margin="0,10,0,5" />
      <Button Content="Refresh Assets" Command="{Binding RefreshAssetsCommand}" HorizontalAlignment="Stretch" />
      <ListBox x:Name="AssetListBox" ItemsSource="{Binding AssetItems}" SelectedItem="{Binding SelectedAsset}" MinHeight="180" MaxHeight="220">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Image Source="{Binding ThumbnailPath}" Width="72" Height="40" Stretch="UniformToFill" />
              <StackPanel>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="#AAAAAA" />
              </StackPanel>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Set as Background" Command="{Binding SetSelectedAssetAsBackgroundCommand}" HorizontalAlignment="Stretch" />
        <Button Content="Add as Overlay" Command="{Binding SetSelectedAssetAsOverlayCommand}" HorizontalAlignment="Stretch" />
      </StackPanel>
      <Border BorderBrush="#444" BorderThickness="1" Padding="4" Margin="0,6,0,0">
        <Image Source="{Binding SelectedAsset.FullPath}" Height="120" Stretch="Uniform" />
      </Border>

      <Button Content="Render Preview" Command="{Binding RenderPreviewCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />

      </StackPanel>
    </ScrollViewer>

    <!-- Status Bar / Log Viewer -->
    <Border Grid.Row="1" Grid.ColumnSpan="3" Background="#222" Padding="6">
      <StackPanel Spacing="4">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="10" Height="10" CornerRadius="5" Background="{Binding NdiOutputStatusColor}" VerticalAlignment="Center" />
          <TextBlock Text="NDI Output:" Foreground="#CFCFCF" FontSize="11" />
          <TextBlock Text="{Binding NdiOutputStatus}" Foreground="White" FontWeight="Bold" FontSize="11" />
        </StackPanel>
        <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="SemiBold" />
        <TextBlock Text="{Binding AutoClearStatusText}" Foreground="#D0D0D0" FontSize="11" />

        <StackPanel Orientation="Horizontal" Spacing="8">
          <CheckBox Content="Debug" IsChecked="{Binding ShowDebugLogs}" Foreground="#D0D0D0" />
          <CheckBox Content="Info" IsChecked="{Binding ShowInformationLogs}" Foreground="#D0D0D0" />
          <CheckBox Content="Warn" IsChecked="{Binding ShowWarningLogs}" Foreground="#D0D0D0" />
          <CheckBox Content="Error" IsChecked="{Binding ShowErrorLogs}" Foreground="#D0D0D0" />
          <CheckBox Content="Fatal" IsChecked="{Binding ShowFatalLogs}" Foreground="#D0D0D0" />
          <CheckBox Content="Auto Scroll" IsChecked="{Binding AutoScrollLogs}" Foreground="#D0D0D0" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <TextBox Width="260" Text="{Binding LogKeyword}" Watermark="Search logs" />
          <Button Content="Clear" Command="{Binding ClearLogKeywordCommand}" />
          <Button Content="Export Logs" Click="ExportLogsButton_OnClick" />
        </StackPanel>

        <ScrollViewer x:Name="LogScrollViewer" Height="120" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding FilteredLogs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Formatted}" Foreground="#CFCFCF" FontSize="11" TextTrimming="CharacterEllipsis" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </StackPanel>
    </Border>
  </Grid>
</Window>
